{
 "description": "Artigo 01, discretização: o exemplo base (padrão dinâmico, choke aberto, 15 bar, partida bloqueada, 3000 s) com os volumes finitos escalonados (conservativos e primitivos) e os esquemas nodais (Galerkin, Petrov-Galerkin, diferenças centrais e regressivas); passo mínimo 1e-6 s.",
 "out_dir": "runs/paper01/discretization",
 "runs": [
  {
   "name": "fv_conservative",
   "case": "cases/severe_slug/well_choke_auto.json",
   "set": [
    "network.edges.choke_2.opening=1.0",
    "integration.min_step=1e-06"
   ],
   "tf": 3000.0
  },
  {
   "name": "fv_primitive",
   "case": "cases/severe_slug/well_choke_auto.json",
   "set": [
    "network.edges.choke_2.opening=1.0",
    "integration.min_step=1e-06",
    "network.edges.1.scheme.options.conservative=false",
    "network.edges.1.scheme.options.relax_target=\"raw\""
   ],
   "tf": 3000.0
  },
  {
   "name": "galerkin",
   "case": "cases/severe_slug/well_choke_auto.json",
   "set": [
    "network.edges.choke_2.opening=1.0",
    "integration.min_step=1e-06",
    "network.edges.1.scheme.type=\"galerkin\""
   ],
   "tf": 3000.0
  },
  {
   "name": "petrov_galerkin",
   "case": "cases/severe_slug/well_choke_auto.json",
   "set": [
    "network.edges.choke_2.opening=1.0",
    "integration.min_step=1e-06",
    "network.edges.1.scheme.type=\"petrov_galerkin\""
   ],
   "tf": 3000.0
  },
  {
   "name": "fd_central",
   "case": "cases/severe_slug/well_choke_auto.json",
   "set": [
    "network.edges.choke_2.opening=1.0",
    "integration.min_step=1e-06",
    "network.edges.1.scheme.type=\"fd_central\""
   ],
   "tf": 3000.0
  },
  {
   "name": "fd_upwind",
   "case": "cases/severe_slug/well_choke_auto.json",
   "set": [
    "network.edges.choke_2.opening=1.0",
    "integration.min_step=1e-06",
    "network.edges.1.scheme.type=\"fd_upwind\""
   ],
   "tf": 3000.0
  }
 ]
}