function [F,saidas,FSS,A,B,ixModel]=modelo_duto_BB(t,x,y,parametros,j)
% Função que gera o vetor de coeficientes da matriz da EDP discretizada
% para o modelo bifásico a 3 equações.
    
% Preparando saídas
saidas=[];
FSS=[];
F=[];
ixModel = [];
if nargin==0
    % Matrizes de coeficientes
    A = [1 2 3;...
         4 5 6;...
         7 8 9];
    B = [10;11;12];
    ixModel = [0;1;1;1];
else

%% Executando cálculos iniciais
    % ny -> 
    % ix -> vetor de ponteiros (1xNk)
    ne = 4; %numero de variaveis de estado (1x1)
    [nx,ny] = size(y); % ny (colunas do vetor de estados)
    ni = nx/ne; % numero de nohs
    nt = length(t); % numero de instantes de tempo
    ix = 1:ne:nx;

    t = ones(ny/nt,1)*t;
    t = ones(ni,1)*t(:)';
    
    g = 9.80665;

    parametrosDuto   = parametros{j};
    parametrosFluido = parametros{j}.Fluido;


%% Extraindo variaveis de entrada
    angulo_teta = interpola_angulo(parametrosDuto.x,parametrosDuto.angulo_teta,x);
    rugo        = parametrosDuto.rugo.*ones(ni,ny);
    D           = parametrosDuto.D.*ones(ni,ny);
    PR          = parametrosDuto.PR;    
    regime      = parametrosDuto.regime;
    
%% Capturando variáveis de estado
    
    % Desempacotando variaveis de estado:
   AUX  = y(ix,:);
   PT   = y(ix+1,:);
   qL   = y(ix+2,:);
   qG   = y(ix+3,:);
   qL   = max(0.001,qL);
   qG   = max(0.001,qG);
   

%% Gerando estados modificados

    P = PR.*PT;

	parameters.diameter = D;
	parameters.roughness = rugo;
	parameters.inclinationAngle = angulo_teta;
    
	parameters.gasPolytrophicCoef = parametrosFluido.gamaG;
	parameters.interfatialTension = parametrosFluido.tensao;
	parameters.liquidViscosity = parametrosFluido.viscL;
	parameters.gasViscosity = parametrosFluido.viscG;
	parameters.referencePressure = parametrosFluido.P0;
	parameters.liquidDensity = parametrosFluido.densL0;
	parameters.gasReferenceDensity = parametrosFluido.densG0;

    
    P2  = P.*(1+1e-3);
    qL2 = qL.*(1+1e-3)+1e-6;
    qG2 = qG.*(1+1e-3)+1e-6;
    
    [tension  ,densS  ,vM  ,alfaL  ,alfaG  ,cL,cG,densL,densG,outputs]  = closure_relations_bb(P, qL, qG,  parameters, regime);

    cL=densL./(P.*parametrosFluido.gamaL);
    cG=densG./(P.*parametrosFluido.gamaG);
    
    [tension_P,densS_P,vM_P,alfaL_P,alfaG_P]  = closure_relations_bb(P2, qL, qG,  parameters, regime);
    [tension_L,densS_L,vM_L,alfaL_L,alfaG_L]  = closure_relations_bb(P, qL2, qG,  parameters, regime);
    [tension_G,densS_G,vM_G,alfaL_G,alfaG_G]  = closure_relations_bb(P, qL, qG2,  parameters, regime);
        
    Mom = densS.*vM;
    Mom_P = densS_P.*vM_P;
    Mom_L = densS_L.*vM_L;
    Mom_G = densS_G.*vM_G;
    
    Vel = densS.*vM.^2;
    Vel_P = densS_P.*vM_P.^2;
    Vel_L = densS_L.*vM_L.^2;
    Vel_G = densS_G.*vM_G.^2;
    
    dMomdP = (Mom_P - Mom)./(P2-P);
    dMomdqL = (Mom_L - Mom)./(qL2-qL);
    dMomdqG = (Mom_G - Mom)./(qG2-qG);
    
    dVeldP = (Vel_P - Vel)./(P2-P);
    dVeldqL = (Vel_L - Vel)./(qL2-qL);
    dVeldqG = (Vel_G - Vel)./(qG2-qG);

    dalfaGdP = (alfaG_P - alfaG)./(P2-P);
    dalfaGdqL = (alfaG_L - alfaG)./(qL2-qL);
    dalfaGdqG = (alfaG_G - alfaG)./(qG2-qG);    
    
    A11 = PR.*(alfaL.*cL-densL.*dalfaGdP);
    A12 = -densL.*dalfaGdqL;
    A13 = -densL.*dalfaGdqG;
    
    A21 = PR.*(alfaG.*cG+densG.*dalfaGdP);
    A22 = densG.*dalfaGdqL;
    A23 = densG.*dalfaGdqG;
    
    A31 = PR.*(dMomdP);
    A32 = dMomdqL;
    A33 = dMomdqG;
    
    [n1,n2] = size(P);
    zers = zeros(n1,n2);
    Area = pi.*D.^2./4;
    B11 = zers;
    B12 = Area.^-1;
    B13 = zers;
    B21 = zers;
    B22 = zers;
    B23 = Area.^-1;
    B31 = PR.*(1+sign(vM).*dVeldP);
    B32 =   sign(vM).*dVeldqL;
    B33 =   sign(vM).*dVeldqG;
    
    C1 = zers;
    C2 = zers;
    C3 = pi.*D.*tension./Area+densS.*g.*sin(angulo_teta);
    
    for i=1:n1
        for j=1:n2
            Matriz_A = [A11(i,j) A12(i,j) A13(i,j) ;...
                        A21(i,j) A22(i,j) A23(i,j) ;...
                        A31(i,j) A32(i,j) A33(i,j) ];
            Matriz_B = [B11(i,j) B12(i,j) B13(i,j) ;...
                        B21(i,j) B22(i,j) B23(i,j) ;...
                        B31(i,j) B32(i,j) B33(i,j) ];
            Matriz_C = [C1(i,j);...
                        C2(i,j);...
                        C3(i,j)];
                    
            inv_Matriz_A = inv(Matriz_A);
            MA = inv_Matriz_A*Matriz_B;
            MB = inv_Matriz_A*Matriz_C;
            
            F1(i,j) = MA(1,1);
            F2(i,j) = MA(1,2);
            F3(i,j) = MA(1,3);
            F4(i,j) = MA(2,1);
            F5(i,j) = MA(2,2);
            F6(i,j) = MA(2,3);
            F7(i,j) = MA(3,1);
            F8(i,j) = MA(3,2);
            F9(i,j) = MA(3,3);
            F10(i,j) = MB(1,1);
            F11(i,j) = MB(2,1);
            F12(i,j) = MB(3,1);

        end
    end
                    
%% Coeficientes do modelo
    
    % Calculando a dissipação
    FSS=(pi.*D.*tension./Area+g.*densS.*sin(angulo_teta));
    
    % Deteminando o vetor de saida do modelo
        
    F = [F1;F2;F3;F4;F5;F6;F7;F8;F9;F10;F11;F12];    

%% Calculando saídas
    if nargout>1
        
        saidas.inclinacao   = angulo_teta;
        saidas.diametro     = D;
        saidas.hD           = zeros(size(qL));
        saidas.alfaL        = alfaL;
        saidas.alfaG        = alfaG;
        saidas.pressao      = P./1e5;
        saidas.vazaoMassaL  = qL;
        saidas.vazaoMassaG  = qG;
        saidas.vazaoVolL    = qL./densL;
        saidas.vazaoVolG    = qG./densG;
        saidas.vazaoMassa   = qL + qG;
        saidas.vazaoVol     = qL./densL + qG./densG;
        saidas.velocidadeL  = qL./densL./(Area.*alfaL);
        saidas.velocidadeG  = qG./densG./(Area.*alfaG);
        saidas.velocidadeSL = qL./densL./Area;
        saidas.velocidadeSG = qG./densG./Area;
        saidas.velocidadeI  = saidas.velocidadeL-saidas.velocidadeG;
        saidas.densidadeL   = densL;
        saidas.densidadeG   = densG;
        saidas.flTra        = outputs.flTra;
        saidas.flEst        = outputs.flEst;
        saidas.flInt        = outputs.flInt;
        saidas.flDis        = outputs.flDis;
    end
end

function yi = interpola_angulo(x,y,xi)
[nxi1,nxi2] = size(xi);
yi = zeros(nxi1,nxi2);
nx = length(x);

for i=1:nxi1
    for j=1:nxi2
        ix2 = find(x==xi(i,j));
        if ~isempty(ix2)
            if ix2==1,      yi(i,j) = y(1);
            elseif ix2==nx, yi(i,j) = y(end);
            else            yi(i,j) = 0.5.*(y(ix2)+y(ix2-1));
            end
        else
            ix2 = find(x<=xi(i,j));
            yi(i,j) = y(ix2(end));
        end
    end
end


function [tension,densS,vM,HL,HG,cL,cG,densL,densG,outputs,fl]  = closure_relations_bb(pressure, qL, qG,  parameters, regime)
% Function that determines shear stress (tension), the mixture density 
% (densS), the phases velocities and the hold-ups according to
% Beggs and Brill correlation (1973).
%
% Input Variables:
% pressure -> pressure in Pa
% vSL -> Liquid superficial velocity (m/s)
% vSG -> Gas superficial velocity (m/s)
% parameters -> struc com os seguintes campos
%   .diameter -> pipe diameters in m
%   .roughness -> pipe roughness in m
%   .inclinationAngle -> inclination angle in relation to horizon plane
%   (rad)
%   .gasPolytrophicCoef -> gas polytrophic coefficient (-)
%   .interfatialTension -> interfatial tension (Pa.m)
%   .liquidViscosity -> liquid viscosity (Pa.s)
%   .gasViscosity -> gas viscosity (Pa.s)
%   .referencePressure -> reference pressure (Pa)
%   .liquidDensity -> liquid density
%   .gasReferenceDensity -> gas reference density
%  
%
% Output Variables:
% tension -> shear stress in Pa
% densS -> mixture density
% vL -> liquid velocity
% vG -> gas velocity
% HL -> liquid hold-up
% HG -> gas hold-up

%% (1) Initial Calculations

% Constants definition
g    = 9.80665; % m/s²



% Filtering pressures lower then 1 bar
pressure = max(1e5,pressure);

% Unpacking parameters
diameter               = parameters.diameter;
roughness              = parameters.roughness;
inclinationAngle       = parameters.inclinationAngle;
gasPolytrophicCoef     = parameters.gasPolytrophicCoef;
interfatialTension     = parameters.interfatialTension;
liquidViscosity        = parameters.liquidViscosity;
gasViscosity           = parameters.gasViscosity;
referencePressure      = parameters.referencePressure;
liquidDensity          = parameters.liquidDensity;
gasReferenceDensity    = parameters.gasReferenceDensity;

% Densities Calculation
densL=liquidDensity;
densG=gasReferenceDensity.*(pressure./referencePressure).^...
    (1/gasPolytrophicCoef);

Area = pi.*diameter.^2./4;
vSL = qL./densL./Area;
vSG = qG./densG./Area;

% Direction
direction = zeros(size(vSL));
direction(vSL>0)  =  1;
direction(vSL<=0) = -1;

vSL = abs(vSL);
vSG = abs(vSG);

% Cross section area calculation
A = pi.*diameter.^2./4;

% Mixture velocity calculation
vm = vSL + vSG;


%% (2) Calculating non-slip variables

% Non-slip hold-up 
lambdaL = vSL ./ (vm+1e-9);
lambdaG = vSG ./ (vm+1e-9);

ix = lambdaL>1;
lambdaL(ix) = 1;
lambdaG(ix) = 0;

ix = lambdaG>1;
lambdaG(ix) = 1;
lambdaL(ix) = 0;

% Mixture properties
densN = densL.*lambdaL + densG.*lambdaG;
viscN = liquidViscosity.*lambdaL + gasViscosity.*lambdaG;

% Dimensionless numbers
NFR = vm.^2./(g.*diameter);% Froude Number
NLV = vSL.*(densL./interfatialTension./g).^(1/4); % Liquid Velocity Number
NRE = densN.*vm.*diameter./viscN; % Mixture Reynolds number

%% (3) Flow Pattern Identification
[fl2,L1,L2,L3] =  pattern_identification(lambdaL,NFR);

if regime==6 % Determinando o regime de escoamento
    fl = fl2;
else % Fixando algum regime predeterminado
    zers = zeros(size(L1));
    fl.Tra=zers;
    fl.Est=zers;
    fl.Int=zers;
    fl.Dis=zers;
    switch regime
        case 1 % Fixando regime anular
            fl.Tra(:,:)=1;
        case 2 % Fixando regime bolhas
            fl.Dis(:,:)=1;
        case 3 % Fixando regime intermitente
            fl.Int(:,:)=1;
        case 4 % Fixando regime estratificado suave
            fl.Est(:,:)=1;
        case 5 % Fixando regime estratificado ondulado
            fl.Est(:,:)=1;
    end
end

%% (4) Liquid Hold-up for horizontal flow
[HL0] =  calculate_HL0(lambdaL,NFR);

%% (5) Inclination Correction factor
[qsi] =  calculate_qsi(lambdaL,NFR,NLV,inclinationAngle,direction);

%% (6) Liquid Hold-up for any inclination and phases velocities
[HL,HG] = calculate_HL(NFR,fl,HL0,qsi,L2,L3);
ix1 = find(HG<1e-6);
HG(ix1)=1e-6;
HL(ix1)=1-1e-6;
ix2 = find(HL<1e-6);
HL(ix2)=1e-6;
HG(ix2)=1-1e-6;

vL = direction.*vSL./HL;
vG = direction.*vSG./HG;

%% (7) Mixture density calculation
densS = HL.*densL+HG.*densG;

%% (7) Single fase Friction Factor Calculation
A1=(2.457*log(1./(0.27*roughness./diameter+(7./NRE).^0.9))).^16;
B1=(37530./NRE).^16;
f=4.*(2.*((8./NRE).^12+1./(A1+B1).^1.5).^(1./12));

%% (8) Beggs and Brill Friction Factor Calculation
k = log(lambdaL./(HL.^2));
S = log(2.2.*exp(k)-1.2);
ix = find(k<=0|k>=0.1823);
S(ix) = (-0.0523.*k(ix).^(-1)+3.1820-0.8725.*k(ix)+0.01853.*k(ix).^3).^(-1);
S(ix1) = 0; S(ix2) = 0;
ftp = f .*exp(S);

%% (9) Beggs and Brill Shear Stress Calculation

tension = direction.*(ftp.*densS.*vm.^2)./8;

outputs.pressure  = pressure;
outputs.HL = HL;
outputs.HG = HG;
outputs.NFR = NFR;
outputs.NLV = NLV;
outputs.NRE = NRE;
outputs.lambdaL = lambdaL;
outputs.lambdaG = lambdaG;
outputs.densL = densL;
outputs.densG = densG;
outputs.densS = densS;
outputs.flTra = fl.Tra;
outputs.flEst = fl.Est;
outputs.flInt = fl.Int;
outputs.flDis = fl.Dis;
outputs.vm = vm;

vM = (HL.*densL.*vL+HG.*densG.*vG)./(HL.*densL+HG.*densG);
cL=zeros(size(pressure));
cG=densG./(pressure.*gasPolytrophicCoef);



%% Subfunction
function [fl,L1,L2,L3,reg] =  pattern_identification(lambdaL,NFR)
% Function that determines the flow pattern according to Beggs and Brill
% correlation (1973)
%
% Input Variables:
% lambdaL -> non-slip liquid hold-up
% NFR -> Liquid Froude number
%
% Output Variables:
% fl -> struct variable with the following fields:
%   .Tra -> is near one when transition pattern, otherwise is near zero.
%   .Est -> is near one when segregatted pattern, otherwise is near zero.
%   .Int -> is near one when Intermittent pattern, otherwise is near zero.
%   .Dis -> is near one when Distributed pattern, otherwise is near zero.

% (Sub1 - 1) Flow Pattern identification limits
L1 = 316      .*lambdaL.^(+0.3020);
L2 = 0.0009252.*lambdaL.^(-2.4684);
L3 = 0.10     .*lambdaL.^(-1.4516);
L4 = 0.5      .*lambdaL.^(-6.7380);

% (Sub1 - 2) Sigmoidal-if tests
factorExp = 1e1;
% testA = sigmoidal(factorExp,lambdaL,0.01);
% testB = sigmoidal(factorExp,lambdaL,0.4);
% testC = sigmoidal(factorExp,L1,NFR);
% testD = sigmoidal(factorExp,L2,NFR);
% testE = sigmoidal(factorExp,L3,NFR);
% testF = sigmoidal(factorExp,L4,NFR);

testA = sigmoidal(factorExp,lambdaL./0.01,1);
testB = sigmoidal(factorExp,lambdaL./0.4,1);
testC = sigmoidal(factorExp,L1./NFR,1);
testD = sigmoidal(factorExp,L2./NFR,1);
testE = sigmoidal(factorExp,L3./NFR,1);
testF = sigmoidal(factorExp,L4./NFR,1);


% (Sub1 - 3) Pattern Flags generation

% Segregated
fl.Est = ((1-testA).*testC + testA.*testD).*1+0;
% Transition
fl.Tra = (testA.*testE.*(1-testD)).*1+0;
% Intermittent
fl.Int = ((1-testB).*testA.*testC.*(1-testE) + testB.*testF.*(1-testE)).*1+0;
% Distributed
fl.Dis = ((1-testB).*(1-testC) + testB.*(1-testF)).*1+0;

% (Sub1 - 4) Flag filtering
fl.Tra=max(fl.Tra,0);fl.Tra=min(fl.Tra,1);
fl.Est=max(fl.Est,0);fl.Est=min(fl.Est,1);
fl.Int=max(fl.Int,0);fl.Int=min(fl.Int,1);
fl.Dis=max(fl.Dis,0);fl.Dis=min(fl.Dis,1);

% (Sub1 - 5) Pattern Identifier
reg = 1.*fl.Est + 2.*fl.Tra + 3.*fl.Int + 4.*fl.Dis;

function [F] = sigmoidal(factorExp,x1,x2)
% Sigmoidal function that eliminates discontinuities during if-tests:
% if x1 = x2, then F = 0.5
% elseif x1 > X2, then F tends to 1
% elseif x1 < x2, then F tends to 0
%
% Input variables:
% x1, x2 -> coordinates
%
% Output variables:
% F -> function result
%
% Parameter:
% fatorExp -> factor that smooths the discontinuity

% (Sub2 - 1) Calculation
F= 1./(1+exp(-factorExp.*(x1-x2)));


function [HL0] =  calculate_HL0(lambdaL,NFR)
% Function that determines the liquid hold-up for horizontal flow
% according to Beggs and Brill correlation (1973)
%
% Input Variables:
% lambdaL -> non-slip liquid hold-up
% NFR -> Liquid Froude number
%
% Output Variables:
% HL0 -> Struct with liquid hold-up for horizontal flow for different
% patterns
%   .Est -> horizontal hold-up for Segregated pattern
%   .Int -> horizontal hold-up for Intermittent pattern
%   .Dis -> horizontal hold-up for Distributed pattern

% (Sub3 - 1) Calculating liquid hold-up
a = 0.98; b = 0.4846; c = 0.0868;
HL0.Est = max(a.*(lambdaL.^b)./(NFR.^c),lambdaL);
a = 0.845; b = 0.5351; c = 0.0173;
HL0.Int = max(a.*(lambdaL.^b)./(NFR.^c),lambdaL);
a = 1.065; b = 0.5824; c = 0.0609;
HL0.Dis = max(a.*(lambdaL.^b)./(NFR.^c),lambdaL);

% (Sub3 - 2) Liquid hold-up filtering
HL0.Est=max(HL0.Est,lambdaL);HL0.Est=min(HL0.Est,1);
HL0.Int=max(HL0.Int,lambdaL);HL0.Int=min(HL0.Int,1);
HL0.Dis=max(HL0.Dis,lambdaL);HL0.Dis=min(HL0.Dis,1);


function [qsi] =  calculate_qsi(lambdaL,NFR,NLV,inclinationAngle,direction)
% Function that determines the inclination correction factor
% according to Beggs and Brill correlation (1973)
%
% Input Variables:
% lambdaL -> non-slip liquid hold-up
% NFR -> Liquid Froude number
% NLV -> Liquid velocity number
% inclinationAngle -> pipe inclination in relation to horizon plane
% direction -> flow direction (+1 meand the same direction of pipe and -1
% means opposite direction)
%
% Output Variables:
% qsi -> Struct with inclination correction factors for different
% patterns
%   .Est -> horizontal hold-up for Segregated pattern
%   .Int -> horizontal hold-up for Intermittent pattern
%   .Dis -> horizontal hold-up for Distributed pattern

% (Sub4 - 1) Determining if uphill or downhill
flagAsc = (1 + sign(direction).*sign(inclinationAngle))./2;
flagDesc = 1-flagAsc;

% (Sub4 - 2) Determining correction for downhill
Cd = 4.70; Ce = -0.3692; Cf = 0.1244; Cg = -0.5056;
C = (1-lambdaL).*log(Cd.*(lambdaL.^Ce).*(NLV.^Cf).*(NFR.^Cg));
C = max(C,0);
qsiDesc = 1 + C.*(sin(1.8.*inclinationAngle)-...
    0.333.*(sin(1.8.*inclinationAngle)).^3);

% (Sub4 - 3) Determining correction for segregated
Cd = 0.011; Ce = -3.768; Cf = 3.539; Cg = -1.614;
C = (1-lambdaL).*log(Cd.*(lambdaL.^Ce).*(NLV.^Cf).*(NFR.^Cg));
C = max(C,0);
qsiAsc = 1 + C.*(sin(1.8.*inclinationAngle)-...
    0.333.*(sin(1.8.*inclinationAngle)).^3);
qsi.Est = qsiAsc.*flagAsc + qsiDesc.*flagDesc;

% (Sub4 - 4) Determining correction for intermittent
Cd = 2.96; Ce = 0.305; Cf = -0.4473; Cg = 0.0978;
C = (1-lambdaL).*log(Cd.*(lambdaL.^Ce).*(NLV.^Cf).*(NFR.^Cg));
C = max(C,0);
qsiAsc = 1 + C.*(sin(1.8.*inclinationAngle)-...
    0.333.*(sin(1.8.*inclinationAngle)).^3);
qsi.Int = qsiAsc.*flagAsc + qsiDesc.*flagDesc;

% (Sub4 - 5) Determining correction for distributed
qsiAsc = 1;
qsi.Dis = qsiAsc.*flagAsc + qsiDesc.*flagDesc;


function [HL,HG] = calculate_HL(NFR,fl,HL0,qsi,L2,L3)
% Function that determines the liquid and the gas hold up for any
% inclination according to Beggs and Brill correlation (1973)
%
% Input Variables:
% lambdaL -> non-slip liquid hold-up
% NFR -> Liquid Froude number
% NLV -> Liquid velocity number
% fl  -> struct with flow pattern flags
% HL0 -> struct with horizontal hold-up
% qsi -> struct with inclination correction factors
% L2, L3 -> pattern test factors
%
% Output Variables:
% HL,HG -> Structs with liquid and gas hold-up for any inclination
%   .Est -> horizontal hold-up for Segregated pattern
%   .Int -> horizontal hold-up for Intermittent pattern
%   .Dis -> horizontal hold-up for Distributed pattern

% (Sub5 -1) Calculating liquid hold-up for different flow patterns
HL.Est=HL0.Est.*qsi.Est;
HL.Int=HL0.Int.*qsi.Int;
HL.Dis=HL0.Dis.*qsi.Dis;

% (Sub5 -2) Interpolating liquid hold-up for transition
fi = (L3-NFR)./(L3-L2);
HL.Tra = fi.*HL.Est + (1-fi).*HL.Int;

% (Sub5 -3) Calculating liquid hold-up
HL = HL.Est.*fl.Est + HL.Int.*fl.Int + HL.Dis.*fl.Dis + HL.Tra.*fl.Tra;

% (Sub5 -4) Filtering
HL = max(1e-9,HL);
HL = min(1-1e-9,HL);

% (Sub5 -5) Calculating gas hold-up
HG = 1-HL;