{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mfsim/schema/mfsim-case-1.schema.json",
  "title": "mfsim-case/1",
  "description": "Caso de simulação do mfsim: fluido, referência, tempo, grafo da rede (vértices e arestas), integração e estado inicial. Unidades SI; pressões adimensionais PT = P/PR ou P em Pa. Um ficheiro pode herdar de outro com $extends e trazer só o que muda.",
  "type": "object",
  "required": [
    "schema",
    "name",
    "fluid",
    "reference",
    "time",
    "network",
    "integration"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "mfsim-case/1"
    },
    "$extends": {
      "type": [
        "string",
        "array"
      ],
      "items": {
        "type": "string"
      },
      "description": "Caso(s) base, relativo(s) a este ficheiro: o loader funde este ficheiro sobre a base (io/extends.py) antes de validar; o schema valida o caso expandido."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "description": "Informação livre: proveniência, parâmetros do gerador, corrida de origem."
    },
    "$include": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Bibliotecas externas (ficheiros JSON com a secção library) fundidas antes de resolver $ref."
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "models": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/model"
          }
        },
        "schemes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/scheme"
          }
        }
      }
    },
    "fluid": {
      "$ref": "#/$defs/fluid"
    },
    "reference": {
      "type": "object",
      "required": [
        "PR"
      ],
      "additionalProperties": false,
      "properties": {
        "PR": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "pressão de referência [Pa]: PT = P/PR"
        },
        "state_ref": {
          "type": "object",
          "additionalProperties": false,
          "description": "faixas esperadas dos estados (tolerância absoluta por faixa, tol_range)",
          "properties": {
            "PT": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "qL": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "qG": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      }
    },
    "time": {
      "type": "object",
      "required": [
        "t0",
        "tf",
        "dt_out"
      ],
      "additionalProperties": false,
      "properties": {
        "t0": {
          "type": "number"
        },
        "tf": {
          "type": "number"
        },
        "dt_out": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "settle": {
          "type": "object",
          "additionalProperties": false,
          "description": "Paragem adaptativa (issue 041): integra em janelas e pára quando o sinal fica permanente ou o ciclo se repete; tf passa a ser o tempo máximo.",
          "properties": {
            "window": {
              "$ref": "#/$defs/positive",
              "description": "duração de cada janela [s]"
            },
            "t_min": {
              "type": "number",
              "minimum": 0,
              "description": "tempo mínimo antes de parar [s]"
            },
            "amp_tol": {
              "$ref": "#/$defs/positive",
              "description": "amplitude abaixo da qual o sinal é permanente (unidades do sinal)"
            },
            "rel_tol": {
              "$ref": "#/$defs/positive",
              "description": "concordância relativa de amplitude e período entre duas janelas"
            },
            "signal": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "edge": {
                  "type": "string"
                },
                "node": {
                  "type": "integer"
                },
                "var": {
                  "enum": [
                    "P",
                    "alphaG",
                    "qL",
                    "qG"
                  ]
                },
                "amp_tol": {
                  "$ref": "#/$defs/positive",
                  "description": "amplitude própria deste sinal abaixo da qual é permanente (061)"
                }
              }
            },
            "signals": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "edge": {
                    "type": "string"
                  },
                  "node": {
                    "type": "integer"
                  },
                  "var": {
                    "enum": [
                      "P",
                      "alphaG",
                      "qL",
                      "qG"
                    ]
                  },
                  "amp_tol": {
                    "$ref": "#/$defs/positive",
                    "description": "amplitude própria deste sinal abaixo da qual é permanente (061)"
                  }
                }
              },
              "description": "sinais adicionais (061): todos têm de assentar"
            },
            "match": {
              "enum": [
                "period",
                "envelope"
              ],
              "description": "ciclo repetido: amplitude e período (period) ou amplitude, média, mínimo e máximo (envelope; ciclos com sopros alternados, 061)"
            },
            "capture_cycles": {
              "type": "integer",
              "minimum": 0,
              "description": "061: depois de assentar, continuar este número de ciclos (janela de captura em info.settle.capture); 0 = parar ao assentar"
            },
            "capture_window": {
              "$ref": "#/$defs/positive",
              "description": "061: janela de captura [s] de um estacionário (omissão: window)"
            },
            "window_periods": {
              "type": "integer",
              "minimum": 0,
              "description": "062: ciclos rápidos — quando o período medido cabe este número de vezes na janela, a janela de comparação passa a ter esse número de períodos (0 = desligado)"
            },
            "window_min": {
              "$ref": "#/$defs/positive",
              "description": "062: comprimento mínimo [s] da janela encurtada por window_periods (omissão: 600)"
            }
          }
        }
      }
    },
    "network": {
      "type": "object",
      "required": [
        "vertices",
        "edges"
      ],
      "additionalProperties": false,
      "properties": {
        "vertices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/vertex"
          }
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    },
    "integration": {
      "$ref": "#/$defs/integration"
    },
    "initial_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "edges",
            "guess",
            "steady"
          ],
          "description": "edges: condições iniciais dos dutos e tanques; guess: estimativa de escoamento estabelecido; steady: estado estacionário por Newton a partir de `from` (issue 040)"
        },
        "from": {
          "enum": [
            "edges",
            "guess"
          ],
          "description": "estado de partida do Newton (steady)"
        },
        "perturb": {
          "type": "number",
          "description": "perturbação relativa das pressões dos dutos depois do Newton (steady)"
        },
        "max_iter": {
          "type": "integer",
          "minimum": 1
        },
        "on_failure": {
          "enum": [
            "error",
            "start"
          ],
          "description": "Newton sem convergência: erro, ou partir do estado `from`"
        }
      }
    }
  },
  "$defs": {
    "positive": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "schedule": {
      "description": "Especificação no tempo: constante, tabela linear por partes {t, v} ou rampa {ramp: [t1, t2], from, to}.",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "required": [
            "t",
            "v"
          ],
          "additionalProperties": false,
          "properties": {
            "t": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number"
              }
            },
            "v": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "ramp",
            "to"
          ],
          "additionalProperties": false,
          "properties": {
            "ramp": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            "from": {
              "type": "number"
            },
            "to": {
              "type": "number"
            }
          }
        }
      ]
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "description": "Portas do vértice: alphaG, PT (P/PR) ou P (Pa), qL e qG (kg/s, positivas entrando).",
      "properties": {
        "alphaG": {
          "$ref": "#/$defs/schedule"
        },
        "PT": {
          "$ref": "#/$defs/schedule"
        },
        "P": {
          "$ref": "#/$defs/schedule"
        },
        "qL": {
          "$ref": "#/$defs/schedule"
        },
        "qG": {
          "$ref": "#/$defs/schedule"
        }
      }
    },
    "vertex": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "boundary",
            "junction",
            "tank"
          ]
        },
        "spec": {
          "$ref": "#/$defs/spec"
        },
        "volume": {
          "$ref": "#/$defs/positive"
        },
        "ic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "HG": {
              "type": [
                "number",
                "null"
              ]
            },
            "PT": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "boundary"
              }
            }
          },
          "then": {
            "required": [
              "spec"
            ],
            "properties": {
              "volume": false,
              "ic": false
            }
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "junction"
              }
            }
          },
          "then": {
            "properties": {
              "volume": false,
              "ic": false
            }
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "tank"
              }
            }
          },
          "then": {
            "required": [
              "volume"
            ]
          }
        }
      ]
    },
    "ports": {
      "type": "object",
      "required": [
        "alphaG",
        "PT",
        "qL",
        "qG"
      ],
      "additionalProperties": false,
      "properties": {
        "alphaG": {
          "$ref": "#/$defs/port"
        },
        "PT": {
          "$ref": "#/$defs/port"
        },
        "qL": {
          "$ref": "#/$defs/port"
        },
        "qG": {
          "$ref": "#/$defs/port"
        }
      }
    },
    "port": {
      "enum": [
        "free",
        "dirichlet",
        "neumann"
      ]
    },
    "regime_name": {
      "enum": [
        "annular",
        "bubble",
        "intermittent",
        "stratified_smooth",
        "stratified_wavy"
      ]
    },
    "regime": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "fixed",
            "automatic"
          ]
        },
        "regime": {
          "$ref": "#/$defs/regime_name"
        },
        "k_switch": {
          "$ref": "#/$defs/positive"
        },
        "smooth": {
          "type": "boolean"
        },
        "local": {
          "type": "boolean"
        },
        "local_film": {
          "type": "boolean"
        },
        "local_bubble": {
          "type": "boolean",
          "description": "com local: os critérios de bolhas (transição bolhas/intermitente a 0,25 e verificação das bolhas dispersas) usam só a fração de gás da célula, sem a fração de deriva calculada das vazões (issue 054)"
        },
        "vertical": {
          "type": "object",
          "required": [
            "regime"
          ],
          "additionalProperties": false,
          "properties": {
            "regime": {
              "$ref": "#/$defs/regime_name"
            },
            "angle_deg": {
              "type": "number"
            },
            "blend_deg": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "low_void": {
          "type": "object",
          "required": [
            "regime"
          ],
          "additionalProperties": false,
          "properties": {
            "regime": {
              "$ref": "#/$defs/regime_name"
            },
            "alpha": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "high_void": {
          "type": "object",
          "required": [
            "regime"
          ],
          "additionalProperties": false,
          "properties": {
            "regime": {
              "$ref": "#/$defs/regime_name"
            },
            "alpha": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "two_fluid",
            "drift_flux_bb",
            "single_liquid",
            "single_gas"
          ]
        },
        "regime": {
          "$ref": "#/$defs/regime"
        },
        "closures": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "stratified": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fi_mult": {
                  "type": "number",
                  "minimum": 0
                },
                "v_gt": {
                  "$ref": "#/$defs/positive"
                }
              }
            },
            "bubble": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "drag": {
                  "enum": [
                    "thesis",
                    "physical"
                  ]
                }
              }
            },
            "annular": {
              "type": "object"
            },
            "intermittent": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "slug_frequency": {
                  "enum": [
                    "thesis",
                    "zabaras"
                  ],
                  "description": "frequência de golfada da unidade de golfada: thesis = eq. 5.83 da tese (expoente do código MATLAB); zabaras = Zabaras (2000), Gregory e Scott com fator de inclinação (issue 049)"
                },
                "unit": {
                  "enum": [
                    "thesis",
                    "consistent",
                    "film"
                  ],
                  "description": "unidade de golfada: thesis = fração de gás do filme cortada a 0,95 (sem balanço de massa); consistent = pistão encurtado e alphas <= alphaG para conservar a massa da unidade (issue 050); film = filme de equilíbrio (estratificado ou em queda), fração de pistão do balanço de massa e perda de aceleração na frente do pistão (issue 051)"
                }
              }
            },
            "friction": {
              "type": "object"
            },
            "kinks": {
              "enum": [
                "sharp",
                "smooth"
              ],
              "description": "quinas dos fechamentos: sharp = min/max/abs/clip como na tese; smooth = versões C1 (diâmetro de bolha, escorregamento de Stuhmiller, Andritsos–Hanratty, Kowalski, módulos das velocidades nos equilíbrios; issue 052)"
            }
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "alpha_min": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "alpha_max": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "legacy_convective": {
              "type": "boolean"
            },
            "interfacial_pressure": {
              "type": "number",
              "minimum": 0
            },
            "ip_slip_max": {
              "$ref": "#/$defs/positive"
            },
            "virtual_mass": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "C_vm": {
                      "type": "number",
                      "minimum": 0
                    },
                    "lambda": {
                      "type": "number"
                    }
                  }
                }
              ]
            },
            "derivatives": {
              "enum": [
                "exact",
                "fd"
              ]
            }
          }
        },
        "extra": {
          "type": "object",
          "description": "chaves legadas sem equivalente (passagem direta)"
        }
      }
    },
    "scheme": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "galerkin",
            "petrov_galerkin",
            "fd_central",
            "fd_upwind",
            "fv_upwind",
            "fv_upwind_cons"
          ]
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^fv_": {}
          },
          "properties": {
            "alpha_face": {
              "enum": [
                "upwind",
                "central",
                "muscl"
              ]
            },
            "pg_alpha": {
              "type": "number"
            },
            "q_switch": {
              "$ref": "#/$defs/positive"
            },
            "q_switch_L": {
              "$ref": "#/$defs/positive"
            },
            "q_switch_G": {
              "$ref": "#/$defs/positive"
            },
            "switch_frac": {
              "type": "number",
              "minimum": 0
            },
            "alpha_band": {
              "$ref": "#/$defs/positive"
            },
            "relax_time": {
              "type": "number",
              "minimum": 0
            },
            "limit_alpha": {
              "type": "boolean"
            },
            "limit_band": {
              "$ref": "#/$defs/positive"
            },
            "conservative": {
              "type": "boolean"
            },
            "flux_band": {
              "$ref": "#/$defs/positive"
            },
            "flux_eps": {
              "$ref": "#/$defs/positive"
            },
            "flux_limit": {
              "type": "boolean"
            },
            "art_visc": {
              "type": "number",
              "minimum": 0
            },
            "relax_target": {
              "enum": [
                "raw",
                "noslip"
              ]
            },
            "relax_ramp": {
              "enum": [
                "linear",
                "smooth"
              ],
              "description": "rampa da relaxação da fase que desaparece: linear (quinas em 0 e na banda) ou smooth (C1; issue 052)"
            },
            "closure_alpha": {
              "enum": [
                "mean",
                "donor"
              ]
            },
            "drift_relax": {
              "$ref": "#/$defs/positive"
            },
            "drift_den_min": {
              "$ref": "#/$defs/positive"
            },
            "ic_holdup": {
              "enum": [
                "correlation",
                "given"
              ]
            }
          }
        }
      }
    },
    "geometry": {
      "type": "object",
      "required": [
        "points",
        "segments"
      ],
      "additionalProperties": false,
      "properties": {
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "xyz"
            ],
            "additionalProperties": false,
            "properties": {
              "xyz": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "n"
            ],
            "additionalProperties": false,
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 1
              },
              "grading": {
                "$ref": "#/$defs/positive"
              }
            }
          }
        }
      }
    },
    "pipe_ic": {
      "description": "Condição inicial nodal: arrays num npz ao lado ({arrays: {key, file}}) ou receita (blocked, shut_in).",
      "oneOf": [
        {
          "type": "null",
          "description": "sem condição inicial declarada (usa initial_state.source = guess ou um estacionário)"
        },
        {
          "type": "object",
          "required": [
            "arrays"
          ],
          "additionalProperties": false,
          "properties": {
            "arrays": {
              "type": "object",
              "required": [
                "key"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string"
                },
                "file": {
                  "type": "string"
                }
              }
            },
            "at": {
              "enum": [
                "mesh",
                "scheme"
              ],
              "description": "mesh: nós da malha (interpolados para o esquema); scheme: estado exato nos nós do esquema"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "recipe",
            "s_front",
            "s_top",
            "pocket_alpha",
            "P_out_bar",
            "dP_margin_bar",
            "qL",
            "qG"
          ],
          "additionalProperties": false,
          "properties": {
            "recipe": {
              "const": "blocked"
            },
            "s_front": {
              "type": "number"
            },
            "s_top": {
              "type": "number"
            },
            "pocket_alpha": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "P_out_bar": {
              "$ref": "#/$defs/positive"
            },
            "dP_margin_bar": {
              "type": "number",
              "minimum": 0
            },
            "qL": {
              "type": "number"
            },
            "qG": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "recipe",
            "s_elbow0",
            "alpha_line",
            "alpha_riser",
            "P_out_bar"
          ],
          "additionalProperties": false,
          "properties": {
            "recipe": {
